# Set these variables in your shell or deployment environment; .env is not auto-loaded.
STORAGE_DIR=./data
# DATABASE_URL=sqlite:///./data/metadata.db
DEV_MODE=false
# Server-managed mapping: bearer token -> stable internal principal (max 64 characters).
API_TOKENS={"replace-with-a-long-random-token":"assessment-user"}
MAX_FILE_BYTES=20971520
MAX_REQUEST_BYTES=104857600
MAX_MULTIPART_PARTS=4096
API_BODY_TIMEOUT_SECONDS=30
MAX_ROWS=200000
MAX_COLUMNS=500
MAX_CELLS=5000000
AI_ENABLED=false
# Opt-in sample transmission, with heuristic email/number redaction (not guaranteed anonymization).
AI_INCLUDE_SAMPLES=false
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
